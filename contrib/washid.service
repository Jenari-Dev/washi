[Unit]
Description=Washi daemon (Canon inkjet status, maintenance and notifications)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.github.Jenari_Dev.Washi
ExecStart=%h/.local/bin/washid
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
