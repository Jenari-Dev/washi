pkgbase = washi
	pkgdesc = Status, maintenance, printing and scanning for Canon inkjet printers (a Canon PRINT replacement)
	pkgver = 0.1.5
	pkgrel = 1
	url = https://github.com/Jenari-Dev/washi
	arch = x86_64
	license = GPL-2.0-or-later
	checkdepends = noto-fonts
	makedepends = cargo
	makedepends = gettext
	makedepends = pkgconf
	depends = dbus
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = ki18n
	depends = poppler
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	optdepends = noto-fonts-cjk: Japanese text in the interface and on disc labels
	optdepends = libreoffice: printing Office documents (they are converted to PDF first)
	optdepends = tesseract: text recognition (OCR) when scanning
	optdepends = tesseract-data-eng: English OCR data
	optdepends = tesseract-data-jpn: Japanese OCR data
	optdepends = qt6-webengine: faster PDF preview in Document Print (QtPdf)
	optdepends = qt6-wayland: native Wayland support
	optdepends = xdg-utils: opening web links in your browser
	options = !lto
	source = washi-0.1.5.tar.gz::https://github.com/Jenari-Dev/washi/archive/refs/tags/v0.1.5.tar.gz
