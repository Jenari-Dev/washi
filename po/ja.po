msgstr "テキスト %1"

#, no-javascript-format
msgid "Remove"
msgstr "削除"

#, no-javascript-format
msgid "Nothing on the label yet. Add a picture or some text."
msgstr "レーベルには、まだ何も配置されていません。画像かテキストを追加してください。"

#, no-javascript-format
msgid "Text"
msgstr "テキスト"

#, no-javascript-format
