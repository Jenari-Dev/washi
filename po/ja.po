msgstr "標準"

#, no-javascript-format
msgid "Follow the ring"
msgstr "リングに沿って配置"

#, no-javascript-format
msgid "Radius (mm)"
msgstr "半径（mm）"

#, no-javascript-format
msgid "Start angle (°)"
msgstr "開始角度（°）"

#, no-javascript-format
msgid "Direction"
msgstr "方向"

#, no-javascript-format
